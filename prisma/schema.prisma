generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id                      Int                 @id @default(autoincrement())
  userId                  String
  title                   String              @db.VarChar(40)
  description             String?
  postType                String
  category                String
  location                String
  imageThumbUrl           String?
  imageFullUrl            String?
  imageName               String?
  createdAt               DateTime            @default(now())
  expiresAt               DateTime            @default(dbgenerated("(now() + '6 mons'::interval)"))
  hasCustomExpirationDate Boolean             @default(false)
  soonExpiringPosts       SoonExpiringPosts[]
  reports                 ReportedPosts[]
}

model SoonExpiringPosts {
  id       Int    @id @default(autoincrement())
  postId   Int
  postLink String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model ArchivedPosts {
  id                      Int      @id @default(autoincrement())
  title                   String   @db.VarChar(40)
  description             String?
  postType                String
  category                String
  location                String
  createdAt               DateTime
  hasCustomExpirationDate Boolean
  archivedAt              DateTime @default(now())
  deletionReason          String
}

model ReportedPosts {
  id           Int      @id @default(autoincrement())
  postId       Int
  postLink     String
  reason       String?
  reporterId   String
  reporterLink String
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Resources {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(40)
  url       String
  createdAt DateTime @default(now())
}
